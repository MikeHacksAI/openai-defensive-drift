{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Defensive Drift Experiment Run Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "benchmark_version",
    "git_commit_sha",
    "method",
    "started_at",
    "case_ids",
    "development_or_test"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_version": {
      "type": "string",
      "minLength": 1
    },
    "git_commit_sha": {
      "type": "string",
      "minLength": 7
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "model_id": {
      "type": ["string", "null"]
    },
    "model_parameters": {
      "type": "object"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "case_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "development_or_test": {
      "enum": [
        "DEVELOPMENT",
        "FROZEN_TEST"
      ]
    },
    "latency_ms_total": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "cost_usd_total": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "notes": {
      "type": ["string", "null"]
    }
  }
}