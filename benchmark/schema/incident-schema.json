{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://defensive-drift.mikehacks.ai/schema/incident-schema.json",
  "title": "Defensive Drift Incident Case",
  "description": "A benchmark observation and the historical evidence against which it must be reconciled.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "benchmark_version",
    "observation",
    "historical_incidents",
    "evidence",
    "public_release"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^DD-CASE-[0-9]{4,}$"
    },
    "benchmark_version": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_at",
        "summary",
        "affected_component"
      ],
      "properties": {
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "affected_component": {
          "type": "string",
          "minLength": 1
        },
        "symptoms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expected_state": {
          "type": ["string", "null"]
        },
        "observed_state": {
          "type": ["string", "null"]
        }
      }
    },
    "historical_incidents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "incident_id",
          "summary",
          "remediation_state"
        ],
        "properties": {
          "incident_id": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "remediation_state": {
            "enum": [
              "DETECTED",
              "ACKNOWLEDGED",
              "MITIGATED",
              "PARTIALLY_REMEDIATED",
              "REMEDIATED",
              "RECURRED",
              "UNRESOLVED",
              "UNKNOWN"
            ]
          },
          "closed": {
            "type": ["boolean", "null"]
          },
          "root_cause": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "evidence_type",
          "content"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "evidence_type": {
            "enum": [
              "CONFIGURATION",
              "LOG",
              "SCANNER_FINDING",
              "CODE_CHANGE",
              "INCIDENT_RECORD",
              "DEPLOYMENT_RECORD",
              "SUPPORT_TRANSCRIPT",
              "AI_CHAT_EXPORT",
              "NETWORK_EVENT",
              "MONITORING_ALERT",
              "OTHER"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "source_timestamp": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "source_reference": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "public_release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "sanitization_reviewed"
      ],
      "properties": {
        "status": {
          "enum": [
            "PRIVATE_ONLY",
            "SANITIZATION_PENDING",
            "PUBLIC_APPROVED",
            "PUBLIC_SYNTHETIC"
          ]
        },
        "sanitization_reviewed": {
          "type": "boolean"
        },
        "notes": {
          "type": ["string", "null"]
        }
      }
    }
  }
}